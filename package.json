{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.js --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:sizes": "node scripts/size-report.mjs",
    "check": "npm run build && npm run check:sizes && npm run check:placeholders",
    "build:client": "vite build",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.6"
  }
}
